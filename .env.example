# Add these variables in Vercel Project Settings > Environment Variables.
# Locally, copy this file to .env.local and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only database/storage key. Never add a NEXT_PUBLIC_ prefix to this key.
# Staff authentication is handled by BillDesk, not Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only origin for customer links. Tests must explicitly use their localhost origin.
BILLDESK_PUBLIC_URL=https://billdesk-rho.vercel.app
SERVICE_DESK_DEMO=false
# Set true for an installation whose cashier requires a token for every new bill.
BILLDESK_REQUIRE_TOKEN=false

# Server-only, at least 32 random bytes. Keep stable so active pass links can be resent.
GATE_PASS_SIGNING_SECRET=
